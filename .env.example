# Kitty Glitter environment variables.
# Copy to .env.local for local development. Never commit real values.
# Phase 1 (demo) needs none of these.

# Phase 2: Supabase (login locked to the owner's email)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OWNER_EMAIL=

# Phase 3: Gmail read-only OAuth (server-side only, never NEXT_PUBLIC_)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Phase 5: AI summaries (server-side only)
# ANTHROPIC_API_KEY=
